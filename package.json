{
  "name": "@sakilabs/openbts",
  "license": "GPL-3.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start:client": "pnpm --filter @sakilabs/openbts_client run start",
    "start:server": "pnpm --filter @sakilabs/openbts_server run start",
    "sql:extract-tables": "tsx scripts/extract-postgres-tables.mts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=18",
    "npm": "please-use-pnpm",
    "pnpm": ">=11",
    "yarn": "please-use-pnpm"
  },
  "packageManager": "pnpm@12.8.1"
}
