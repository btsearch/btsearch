    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=18",
    "npm": "please-use-pnpm",
    "pnpm": ">=11",
    "yarn": "please-use-pnpm"
  },
  "packageManager": "pnpm@11.20.0"
