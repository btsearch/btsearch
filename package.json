{
  "name": "@sakilabs/openbts",
  "license": "GPL-3.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start:client": "pnpm --filter @openbts/client run preview",
    "start:server": "pnpm --filter @openbts/sora run start",
    "build:packages": "pnpm --filter \"./packages/**\" run build",
    "sql:extract-tables": "tsx scripts/extract-postgres-tables.mts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=18",
    "npm": "please-use-pnpm",
    "pnpm": ">=11",
    "yarn": "please-use-pnpm"
  },
  "packageManager": "pnpm@12.14.0"
}
