{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react", "react-perf", "promise"],
  "rules": {
    "no-await-in-loop": "error",
    "no-param-reassign": "error",
    "default-param-last": "error",
    "typescript/prefer-enum-initializers": "error",
    "typescript/no-inferrable-types": "error",
    "unicorn/prefer-array-find": "error",
    "unicorn/prefer-array-flat-map": "error",
    "unicorn/prefer-number-properties": "error",
    "unicorn/prefer-set-has": "error",
    "no-else-return": "error",
    "react/self-closing-comp": "error",
    "sort-imports": [
      "error",
      {
        "memberSyntaxSortOrder": ["none", "all", "multiple", "single"],
        "ignoreDeclarationSort": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "packages/country-packs/index.ts",
        "packages/country-packs/core/capabilities.ts",
        "packages/country-packs/core/conventions.ts",
        "packages/country-packs/core/registry.ts",
        "packages/country-packs/*/index.ts",
        "packages/country-packs/*/operators.ts",
        "packages/country-packs/*/emf.ts",
        "packages/country-packs/*/earfcn.ts",
        "packages/country-packs/*/conventions/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": ["drizzle-orm", "@openbts/drizzle", "xlsx", "cheerio"],
            "patterns": ["node:*", "node:*/**", "drizzle-orm/**", "@openbts/drizzle/**", "xlsx/**", "cheerio/**"]
          }
        ]
      }
    }
  ],
  "options": {
    "typeAware": true
  },
  "ignorePatterns": ["*.gen.ts", "**/dist/**", "**/dist-ssr/**", "apps/client/src/components/auth/**/*"]
}
