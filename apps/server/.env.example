PORT=3030
DATABASE_URL="postgresql://"
BETTER_AUTH_SECRET=

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# App settings
APP_NAME=OpenBTS
# Public origin used for auth callbacks, canonical URLs, social metadata and sitemap entries
BASE_URL=http://localhost:3030
# Internal client origin used to fetch the SPA shell (host dev: http://localhost:5173, Docker/Swarm: http://client)
CLIENT_ORIGIN=http://localhost:5173
# Private OG image renderer origin (Docker/Swarm: http://og-renderer:3040)
OG_RENDERER_URL=http://localhost:3040
# Dedicated listener port for pnpm dev:og-renderer
OG_RENDERER_PORT=3040
OG_RENDERER_HOST=127.0.0.1

# Official-data imports
# Scheduling of imports by the server
OFFICIAL_AUTO_IMPORT=true
# Direct Postgres URL (not PgBouncer) that the deployment files give the importer service as its DATABASE_URL
IMPORTER_DATABASE_URL="postgresql://"
# Directory that archives every downloaded file
OFFICIAL_ARCHIVE_DIR=official-archive
# Replicas of the importer service
IMPORTER_REPLICAS=1

# PWA notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NOTIFICATION_DIGEST_INTERVAL_MS=300000

# Resend (email)
RESEND_API_KEY=
RESEND_FROM=noreply@btsearch.pl

# Measurements from the BTSearch app
# The client_id of every measurement app's OAuth client, comma-separated; each is written by scripts/setupAppClient.ts
APP_OAUTH_CLIENT_IDS=
# 32 random bytes in base64 (openssl rand -base64 32); keys the HMAC of the phone id
OBSERVATIONS_PHONE_KEY=
# Where raw uploads go: disk (the only store built so far)
OBSERVATIONS_STORE=disk
OBSERVATIONS_DIR=/app/observations
# Keys that seal raw uploads, newest first: id:base64 of 32 random bytes, separated by commas, e.g. 2026:<key>,2025:<key>
OBSERVATIONS_SEAL_KEYS=

# Geocoding, requests alternate between the configured providers
GEOAPIFY_API_KEY=
LOCATIONIQ_API_KEY=

# AXIOM HQ logging
AXIOM_TOKEN=
AXIOM_DATASET=
