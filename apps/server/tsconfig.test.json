{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "../..",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["../client/src/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist", "src/v1/old/**/*"]
}
