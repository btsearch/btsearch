{
  "name": "@openbts/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Shared utilities for client and server",
  "type": "module",
  "exports": {
    "./frequency": {
      "types": "./src/frequency.ts",
      "default": "./dist/src/frequency.js"
    },
    "./operatorUtils": {
      "types": "./src/operatorUtils.ts",
      "default": "./dist/src/operatorUtils.js"
    },
    "./radiolinesUtils": {
      "types": "./src/radiolinesUtils.ts",
      "default": "./dist/src/radiolinesUtils.js"
    },
    "./addressValidation": {
      "types": "./src/addressValidation.ts",
      "default": "./dist/src/addressValidation.js"
    },
    "./clfExportTemplates": {
      "types": "./src/clfExportTemplates.ts",
      "default": "./dist/src/clfExportTemplates.js"
    }
  },
  "scripts": {
    "build": "tsgo",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@openbts/typescript-configs": "workspace:*"
  }
}
