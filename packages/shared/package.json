{
  "name": "@openbts/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Shared utilities for client and server",
  "type": "module",
  "exports": {
    "./frequency": {
      "types": "./src/frequency.ts",
      "default": "./dist/src/frequency.js"
    },
    "./bandCatalog": {
      "types": "./src/bandCatalog.ts",
      "default": "./dist/src/bandCatalog.js"
    },
    "./operatorUtils": {
      "types": "./src/operatorUtils.ts",
      "default": "./dist/src/operatorUtils.js"
    },
    "./geo": {
      "types": "./src/geo.ts",
      "default": "./dist/src/geo.js"
    },
    "./microwaveLinkUtils": {
      "types": "./src/microwaveLinkUtils.ts",
      "default": "./dist/src/microwaveLinkUtils.js"
    },
    "./clfExportTemplates": {
      "types": "./src/clfExportTemplates.ts",
      "default": "./dist/src/clfExportTemplates.js"
    },
    "./terrainProfile": {
      "types": "./src/terrainProfile.ts",
      "default": "./dist/src/terrainProfile.js"
    },
    "./cellTypes": {
      "types": "./src/cellTypes.ts",
      "default": "./dist/src/cellTypes.js"
    },
    "./audit": {
      "types": "./src/audit.ts",
      "default": "./dist/src/audit.js"
    },
    "./seo": {
      "types": "./src/seo.ts",
      "default": "./dist/src/seo.js"
    },
    "./stationId": {
      "types": "./src/stationId.ts",
      "default": "./dist/src/stationId.js"
    },
    "./permitLabel": {
      "types": "./src/permitLabel.ts",
      "default": "./dist/src/permitLabel.js"
    },
    "./contract": {
      "types": "./src/contract/index.ts",
      "default": "./dist/src/contract/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@openbts/typescript-configs": "workspace:*"
  }
}
