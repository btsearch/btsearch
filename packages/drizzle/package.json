{
  "name": "@openbts/drizzle",
  "version": "1.0.0",
  "private": true,
  "description": "Drizzle schemas",
  "type": "module",
  "exports": {
    ".": {
      "types": "./schemas/index.ts",
      "default": "./dist/schemas/index.js"
    },
    "./db": {
      "types": "./db.ts",
      "default": "./dist/db.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "db:generate": "drizzle-kit generate && tsx minifySnapshots.ts",
    "db:migrate": "tsx migrate.ts",
    "db:migrate:kit": "drizzle-kit migrate",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@openbts/shared": "workspace:*",
    "dotenv": "18.0.9",
    "drizzle-orm": "1.0.0-rc.5",
    "nanoid": "6.0.2",
    "postgres": "4.0.0",
    "redis": "6.3.1"
  },
  "devDependencies": {
    "@openbts/typescript-configs": "workspace:*",
    "@types/node": "26.6.6",
    "drizzle-kit": "1.0.0-rc.5"
  }
}
